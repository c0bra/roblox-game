{
  "$schema": "https://raw.githubusercontent.com/rojo-rbx/rojo/master/schemas/project.json",
  "name": "BandsBattle",
  "servePort": 34872,
  "tree": {
    "$className": "DataModel",
    "$ignoreUnknownInstances": true,
    "ReplicatedStorage": {
      "$ignoreUnknownInstances": true,
      "$path": "src/shared"
    },
    "ServerScriptService": {
      "$ignoreUnknownInstances": true,
      "$path": "src/server"
    },
    "StarterPlayer": {
      "$ignoreUnknownInstances": true,
      "StarterPlayerScripts": {
        "$ignoreUnknownInstances": true,
        "$path": "src/client"
      }
    }
  }
}
